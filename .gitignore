# -------------------------

# Terraform

# -------------------------

# Terraform working directory

**/.terraform/*
.terraform/

# Terraform state files

*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs

crash.log
crash.*.log

# Terraform variable files (may contain secrets)

*.tfvars
*.tfvars.json

# Keep example variable files

!*.tfvars.example

# Terraform override files

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration

.terraformrc
terraform.rc

# Terraform plan files

*.tfplan
*.plan

